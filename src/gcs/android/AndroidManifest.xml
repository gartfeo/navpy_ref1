<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen Android shell for the handheld GCS.
     It shows the page the Termux backend serves at 127.0.0.1:8000; the
     backend itself still runs in Termux. Built by scripts/termux/build_apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aas.gcs"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: the backend is plain HTTP on loopback. -->
    <application
        android:label="AAS GCS"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
